config network MyProject.simulations.EmailNetwork
config sim-time-limit 15s
config *.cloud.delayMean 0.05s
config *.cloud.delayJitter 0.02s
config *.cloud.dropProbability 0.0
config *.spam.spamKeywords "\"free,prize\""
